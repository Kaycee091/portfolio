# ============================================
# PORTFOLIO ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# JWT Secret (change to a long random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin Credentials (used to seed the initial admin account)
ADMIN_EMAIL=admin@portfolio.local
ADMIN_PASSWORD=PortfolioAdmin2024!

# Admin Display Name
ADMIN_NAME=Kenechukwu Asogwa

# Base URL (for production, set to your actual domain)
BASE_URL=http://localhost:3000
